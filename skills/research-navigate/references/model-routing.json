  "decision_services": {
    "jev": {
      "kind": "structured_decision",
      "optional": true,
      "adapter": "scripts/jev_decide.py",
      "default_model": "jev-latest",
      "runtime_models": [
        "jev-latest"
      ],
      "credential_env": "TYPESAFE_API_KEY",
      "explicit_config_fields": [
        "api_key_env",
        "models"
      ],
      "endpoint": "https://api.typesafe.ai/v1/systemone",
      "quota_pool": "jev",
      "max_concurrency": 1,
      "pool_state": "unknown",
      "credit_coverage": "unverified",
      "generative_worker": false,
      "review_eligible": false,
      "primitive_types": [
        "choice",
